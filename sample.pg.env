# =============================================================================
# PostgreSQL Backup Configuration
# =============================================================================
# Copy this file to your envs/ directory and fill in the values.
# Permissions on this file must be 600 (the script enforces this automatically).
# Never commit this file to version control.
#
# Usage: ./backup.sh /root/backup/envs/mydb.env
# =============================================================================

# ── Database connection ───────────────────────────────────────────────────────
DB_HOST=db.example.internal
DB_PORT=5432
DB_NAME=mydb
DB_USER=backup_user
DB_PASSWORD=changeme
DB_SCHEMA=public

# ── Docker ───────────────────────────────────────────────────────────────────
# The postgres image to use for running pg_dump.
# This does not need to be a running container — docker run pulls and discards it.
DB_CONTAINER=postgres:16

# ── Backup destination ────────────────────────────────────────────────────────
BACKUP_DST=/tmp
DROPBOX_DIR=/postgresql/mydb

# ── Encryption ───────────────────────────────────────────────────────────────
# Path to a file containing the GPG passphrase (must be chmod 600).
# Generate with:
#   openssl rand -base64 48 > /root/.backup_passphrase
#   chmod 600 /root/.backup_passphrase
BACKUP_PASSPHRASE_FILE=/root/.backup_passphrase
