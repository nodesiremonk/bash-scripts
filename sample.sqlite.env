# =============================================================================
# SQLite Backup Configuration
# =============================================================================
# Copy this file to your envs/ directory and fill in the values.
# Permissions on this file must be 600 (the script enforces this automatically).
# Never commit this file to version control.
#
# Usage: ./backup_sqlite.sh /root/backup/envs/mydb.env
# =============================================================================

# ── Database name (used for logging only) ────────────────────────────────────
DB_NAME=mydb

# ── Mode ─────────────────────────────────────────────────────────────────────
# Choose one of three modes and fill in the corresponding section below:
#
#   local          sqlite3 and the .db file are both on the host filesystem
#   docker_exec    sqlite3 and the .db file are both inside a running container
#   docker_local   sqlite3 is in a container image; the .db file is on the host
#
DB_MODE=local

# ── Mode: local ──────────────────────────────────────────────────────────────
# sqlite3 must be installed on the host (apt install sqlite3).
# DB_CONTAINER is not used in this mode.
#
DB_PATH=/var/data/app.db

# ── Mode: docker_exec ────────────────────────────────────────────────────────
# The container must already be running and have sqlite3 installed inside it.
# DB_PATH is the path to the .db file inside the container.
#
# DB_MODE=docker_exec
# DB_CONTAINER=my_app_container
# DB_PATH=/app/data/app.db

# ── Mode: docker_local ───────────────────────────────────────────────────────
# sqlite3 is provided by a Docker image; the .db file lives on the host.
# The script mounts DB_PATH into the container read-only.
# DB_CONTAINER can be any image that ships sqlite3 (e.g. keinos/sqlite3).
#
# DB_MODE=docker_local
# DB_CONTAINER=keinos/sqlite3
# DB_PATH=/var/data/app.db

# ── Backup destination ────────────────────────────────────────────────────────
BACKUP_DST=/tmp
DROPBOX_DIR=/sqlite/mydb

# ── Encryption ───────────────────────────────────────────────────────────────
# Path to a file containing the GPG passphrase (must be chmod 600).
# Generate with:
#   openssl rand -base64 48 > /root/.backup_passphrase
#   chmod 600 /root/.backup_passphrase
BACKUP_PASSPHRASE_FILE=/root/.backup_passphrase
